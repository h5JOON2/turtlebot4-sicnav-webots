DEF TURTLEBOT4 Robot {
  translation 0 -5 0.05
  rotation 0 0 1 1.5708
  children [
    Pose {
      translation 0 0 0.035
      children [
        Shape {
          appearance PBRAppearance {
            baseColor 0.1 0.1 0.1
            roughness 0.3
          }
          geometry Cylinder {
            height 0.07
            radius 0.17
          }
        }
      ]
    }
    Pose {
      translation 0 0 0.15
      children [
        Shape {
          appearance PBRAppearance {
            baseColor 0.2 0.5 0.2
            roughness 0.4
          }
          geometry Cylinder {
            height 0.16
            radius 0.13
          }
        }
      ]
    }
    Pose {
      translation 0 0 0.26
      children [
        Lidar {
          name "rplidar"
          horizontalResolution 360
          fieldOfView 6.2831853
          numberOfLayers 1
          minRange 0.15
          maxRange 12
        }
        Shape {
          appearance PBRAppearance {
            baseColor 0.05 0.05 0.05
          }
          geometry Cylinder {
            height 0.04
            radius 0.04
          }
        }
      ]
    }
    InertialUnit {
      name "inertial_unit"
    }
    Receiver {
      name "robot_receiver"
    }
    HingeJoint {
      jointParameters HingeJointParameters {
        axis 0 1 0
        anchor 0 0.1165 0.036
      }
      device [
        RotationalMotor {
          name "left_wheel_motor"
          maxVelocity 20
        }
        PositionSensor {
          name "left_wheel_sensor"
        }
      ]
      endPoint Solid {
        translation 0 0.1165 0.036
        rotation 1 0 0 1.5708
        children [
          Shape {
            appearance PBRAppearance {
              baseColor 0.05 0.05 0.05
            }
            geometry Cylinder {
              height 0.02
              radius 0.036
            }
          }
        ]
        name "left_wheel_solid"
        boundingObject Cylinder {
          height 0.02
          radius 0.036
        }
        physics Physics {
          density -1
          mass 0.2
        }
      }
    }
    HingeJoint {
      jointParameters HingeJointParameters {
        axis 0 1 0
        anchor 0 -0.1165 0.036
      }
      device [
        RotationalMotor {
          name "right_wheel_motor"
          maxVelocity 20
        }
        PositionSensor {
          name "right_wheel_sensor"
        }
      ]
      endPoint Solid {
        translation 0 -0.1165 0.036
        rotation 1 0 0 1.5708
        children [
          Shape {
            appearance PBRAppearance {
              baseColor 0.05 0.05 0.05
            }
            geometry Cylinder {
              height 0.02
              radius 0.036
            }
          }
        ]
        name "right_wheel_solid"
        boundingObject Cylinder {
          height 0.02
          radius 0.036
        }
        physics Physics {
          density -1
          mass 0.2
        }
      }
    }
  ]
  name "turtlebot4"
  boundingObject Pose {
    translation 0 0 0.16
    children [
      Cylinder {
        height 0.22
        radius 0.16
      }
    ]
  }
  physics Physics {
    density -1
    mass 4.5
    centerOfMass [
      0 0 0.06
    ]
